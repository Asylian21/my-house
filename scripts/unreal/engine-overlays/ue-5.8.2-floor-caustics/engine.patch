+// Source-pinned direct diffuse only. No light function or material emission.
+#include "Common.ush"
+#include "DeferredShadingCommon.ush"
+#include "ShadingEnergyConservation.ush"
+
+Texture2D NormalizedIrradiance;
+SamplerState IrradianceSampler;
+float3 SourceMinTranslated;
+float3 SourceMaxTranslated;
+float3 SourceSunIlluminance;
+float SourceDiffuseScale;
+uint SourceStencil;
+uint OccluderExclusionCount;
+float4 OccluderExclusions[32];
+RWBuffer<uint> ValidationCounters;
+
+void PreparePS(float4 SvPosition : SV_Position, out float4 Out : SV_Target0)
+{
+    ResolvedView = ResolveView();
+    Out = 0;
+    uint2 Pixel = uint2(SvPosition.xy);
+    float2 UV = SvPosition.xy * View.BufferSizeAndInvSize.zw;
+    if (CalcSceneCustomStencil(Pixel) != SourceStencil) return;
+    float Z = CalcSceneDepth(UV), CustomZ = CalcSceneCustomDepth(UV);
+    if (!isfinite(Z) || !isfinite(CustomZ) || abs(Z - CustomZ) > 0.05) return;
+    FGBufferData G = GetGBufferData(UV);
+    if (G.ShadingModelID != SHADINGMODELID_DEFAULT_LIT || G.WorldNormal.z < 0.8) return;
+    float3 P = SvPositionToResolvedTranslatedWorld(float4(SvPosition.xy, LookupDeviceZ(UV), 1));
+    if (any(!isfinite(P)) || any(!isfinite(G.WorldNormal))) return;
+    if (abs(P.z - SourceMaxTranslated.z) > 0.05 ||
+        any(P.xy <= SourceMinTranslated.xy + 0.05) || any(P.xy >= SourceMaxTranslated.xy - 0.05)) return;
+    [loop] for (uint Index = 0; Index < OccluderExclusionCount; ++Index)
+    {
+        float4 R = OccluderExclusions[Index];
+        if (all(P.xy >= R.xy) && all(P.xy <= R.zw))
+        { InterlockedAdd(ValidationCounters[3], 1); return; }
+    }
+    float2 AtlasUV = (P.xy - SourceMinTranslated.xy) / (SourceMaxTranslated.xy - SourceMinTranslated.xy);
+    float3 E = NormalizedIrradiance.SampleLevel(IrradianceSampler, AtlasUV, 0).rgb;
+    if (any(!isfinite(E)) || any(E < 0)) { InterlockedAdd(ValidationCounters[1], 1); return; }
+    float NoV = saturate(abs(dot(G.WorldNormal, GetCameraVectorFromTranslatedWorldPosition(P))) + 1e-5);
+    FBxDFEnergyTerms Energy = ComputeGGXSpecEnergyTerms(G.Roughness, NoV, G.SpecularColor);
+    // Same optional stock GGX specular-layer energy preservation on Lambert diffuse.
+    float3 C = ComputeEnergyPreservation(Energy) * G.DiffuseColor * E * SourceSunIlluminance * (SourceDiffuseScale / PI) * View.PreExposure;
+    if (any(!isfinite(C)) || any(C < 0) || any(C > 60000))
+    { InterlockedAdd(ValidationCounters[2], 1); return; }
+    InterlockedAdd(ValidationCounters[0], 1);
+    Out = float4(C, 1); // active zero irradiance deliberately removes stock diffuse
+}
+
+Texture2D Replacement;
+void CompositePS(float4 SvPosition : SV_Position, out float4 Out : SV_Target0)
+{
+    float4 C = Replacement.Load(int3(uint2(SvPosition.xy), 0));
+    Out = float4(C.a > 0.5 ? C.rgb : 0, 0);
+}
