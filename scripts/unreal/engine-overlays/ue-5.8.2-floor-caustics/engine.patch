+// Project-local UE 5.8.2 overlay. Default dormant; no UObject ownership on RT.
+#pragma once
+
+#include "CoreMinimal.h"
+#include "LightComponentId.h"
+#include "PrimitiveComponentId.h"
+#include "RenderGraphFwd.h"
+
+class FSceneInterface;
+class FSceneView;
+
+struct FFloorCausticsSelection
+{
+    const FSceneInterface* SceneToken = nullptr;
+    uint64 Generation = 0;
+    FPrimitiveComponentId Floor;
+    FLightComponentId Sun;
+    FBox SourceBoundsCm = FBox(ForceInit);
+    double WaterSurfaceZCm = 0;
+    uint8 UniqueStencil = 0;
+    FString SourceContractSha256;
+};
+
+struct FFloorCausticsBuildInputs
+{
+    FFloorCausticsSelection Selection;
+    uint64 FrameCounter = 0;
+    uint32 FrameNumber = 0;
+    float WorldTimeSeconds = 0;
+    // Actual renderer FViewInfo CPU value, not an independently read GPU uniform.
+    float ViewPreExposure = 0;
+    FVector3f SunTravelDirection = FVector3f::ZeroVector;
+    // Normal-incidence solar illuminance in UE's linear light units, after
+    // its ground atmosphere transmittance. NOT pre-exposed, NOT divided by PI.
+    FVector3f SunIlluminance = FVector3f::ZeroVector;
+    // Conservative renderer-owned coplanar/near-plane exclusions. Preserve
+    // these exact IDs/rectangles in diagnostic receipts; never guess new hulls.
+    TArray<FPrimitiveComponentId> ConservativeExcludedPrimitives;
+    TArray<FVector4f> ConservativeExcludedBoundsXYCm;
+};
+
+struct FFloorCausticsProducedFrame
+{
+    const FSceneInterface* SceneToken = nullptr;
+    uint64 Generation = 0;
+    uint64 FrameCounter = 0;
+    uint32 FrameNumber = 0;
+    float WorldTimeSeconds = 0;
+    // Linear RGB dimensionless floor irradiance PER UNIT input SunIlluminance.
+    // Includes projected packet measure, Fresnel and underwater Beer exactly
+    // once; excludes albedo, PI, native sun magnitude and view pre-exposure.
+    // XY maps source-bounds Min.XY -> 0 and Max.XY -> 1 without repeat.
+    FRDGTextureRef NormalizedIrradiance = nullptr;
+    bool bSourceTransportValidated = false;
+};
+
+// Diagnostic snapshots of the real HDR pipeline, before tonemapping/fog after SLW.
+// These names identify scheduling boundaries, not independent lighting proofs.
+enum class EFloorCausticsObservationStage : uint8
+{
+    AfterRenderLights,
+    BeforeComposite,
+    AfterComposite,
+    AfterSingleLayerWater
+};
+
+struct FFloorCausticsObservation
+{
+    EFloorCausticsObservationStage Stage = EFloorCausticsObservationStage::AfterRenderLights;
+    FRDGTextureRef SceneColor = nullptr;
+    FRDGTextureRef SceneDepth = nullptr;
+    FRDGTextureRef Companion = nullptr;
+    // Null when no accepted prepared frame exists (including an inactive control).
+    // This pointer and all textures are callback/graph-local: never retain them.
+    const FFloorCausticsBuildInputs* PreparedInputs = nullptr;
+    bool bComposited = false;
+    // Valid also for an inactive observation with no PreparedInputs.
+    float ViewPreExposure = 0;
+};
+
+class IFloorCausticsProvider
+{
+public:
+    virtual ~IFloorCausticsProvider() = default;
+    // Opt-in but unsupported/invalid frames keep stock lighting and emit an
+    // explicit stage reason. This is not a GPU validation result.
+    virtual void Rejected_RenderThread(const FSceneView&, const TCHAR* StageReason) {}
+    virtual bool Select_RenderThread(const FSceneView& View, FFloorCausticsSelection& Out) = 0;
+    virtual bool Build_RenderThread(FRDGBuilder& GraphBuilder, const FSceneView& View,
+        const FFloorCausticsBuildInputs& Inputs, FFloorCausticsProducedFrame& Out) = 0;
+    // Optional diagnostic hook: graph-local copies/readbacks only. Alpha is
+    // validated receiver ownership, RGB is pre-exposed replacement radiance.
+    // Counters: [owned pixels, invalid irradiance pixels, radiance overflow, excluded pixels].
+    virtual void Observe_RenderThread(FRDGBuilder&, const FSceneView&,
+        const FFloorCausticsBuildInputs&, FRDGTextureRef, FRDGBufferRef) {}
+    // Optional explicit diagnostic subscriber, also called with CVar=0 so an
+    // inactive control can observe the same real stages. No registered provider
+    // means no callback or readback. Implementations must gate a single eligible
+    // frame, issue graph-local copy/readback passes here, and own their fences.
+    // Missing stages and incomplete fences must fail the diagnostic, not pass.
+    virtual void ObserveDownstream_RenderThread(FRDGBuilder&, const FSceneView&,
+        const FFloorCausticsObservation&) {}
+};
+
+// Call via a project-owned enqueued render command. Exactly one provider;
+// registration conflict returns false. Unregister, FlushRenderingCommands,
+// then release project source resources. No provider means stock rendering.
+RENDERER_API bool RegisterFloorCausticsProvider_RenderThread(
+    TSharedRef<IFloorCausticsProvider, ESPMode::ThreadSafe> Provider);
+RENDERER_API void UnregisterFloorCausticsProvider_RenderThread(
+    const IFloorCausticsProvider* Provider);
