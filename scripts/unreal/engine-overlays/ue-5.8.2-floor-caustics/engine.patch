+static bool IntCvarEquals(const TCHAR* Name, int32 Expected)
+{
+    const IConsoleVariable* Cvar = IConsoleManager::Get().FindConsoleVariable(Name);
+    return Cvar && Cvar->GetInt() == Expected;
+}
+static bool IsSha256(const FString& Text)
+{
+    if (Text.Len() != 64) return false;
+    for (TCHAR C : Text) if (!(C >= '0' && C <= '9') && !(C >= 'a' && C <= 'f')) return false;
+    return true;
+}
+static bool FinitePositive(const FVector3f& V)
+{
+    return !V.ContainsNaN() && V.X > 0 && V.Y > 0 && V.Z > 0;
+}
+
+// Only a surface mesh that can contribute opaque/masked main-pass depth can
+// create the coincident-depth ambiguity. Proxy flags alone also describe empty
+// line/point helpers and are not evidence of a material mesh batch.
+static bool IsFloorCausticsOccluderBatch(const FMeshBatch& Mesh, ERHIFeatureLevel::Type FeatureLevel)
+{
+    if (!Mesh.bUseForMaterial || !Mesh.HasAnyDrawCalls() ||
+        Mesh.Type == PT_LineList || Mesh.Type == PT_PointList) return false;
+    // Retain uncertain batches. Do not trigger compilation through the fallback
+    // getter or mistake an incomplete shader map for absent opaque geometry.
+    if (!Mesh.MaterialRenderProxy) return true;
+    const FMaterial* Material = Mesh.MaterialRenderProxy->GetMaterialNoFallback(FeatureLevel);
+    if (!Material || !Material->IsRenderingThreadShaderMapComplete()) return true;
+    return IsOpaqueOrMaskedBlendMode(Material->GetBlendMode());
+}
+
+static bool IsFloorCausticsOccluder(const FViewInfo& View, const FPrimitiveSceneInfo& Info)
+{
+    const FPrimitiveSceneProxy* Proxy = Info.Proxy;
+    if (!Proxy || !Proxy->ShouldRenderInMainPass() || !Proxy->IsShown(&View)) return false;
+    // Game's always-visible Nanite primitives can have uninitialized CPU view
+    // relevance. Keep their bounds conservative; CPU maps are not GPU coverage.
+    if (Proxy->IsNaniteMesh()) return Proxy->IsOpaqueOrMasked();
+
+    const int32 Index = Info.GetIndex(); // Packed scene index, never ComponentId.PrimIDValue.
+    if (Index < 0 || Index >= View.PrimitiveVisibilityMap.Num() ||
+        !View.PrimitiveViewRelevanceMap.IsValidIndex(Index)) return true;
+    if (!View.PrimitiveVisibilityMap[Index]) return false;
+    const FPrimitiveViewRelevance& Relevance = View.PrimitiveViewRelevanceMap[Index];
+    if (!Relevance.bInitializedThisFrame) return true;
+    if (!Relevance.bDrawRelevance || !Relevance.bRenderInMainPass ||
+        Relevance.bEditorPrimitiveRelevance) return false;
+    // Do not reject HasTranslucency(): one primitive may also own opaque sections.
+    if (Relevance.bStaticRelevance)
+    {
+        for (const FStaticMeshBatch& Mesh : Info.StaticMeshes)
+        {
+            if (Mesh.Id < 0 || Mesh.Id >= View.StaticMeshVisibilityMap.Num()) return true;
+            if (View.StaticMeshVisibilityMap[Mesh.Id] &&
+                IsFloorCausticsOccluderBatch(Mesh, View.GetFeatureLevel())) return true;
+        }
+    }
+    if (Relevance.bDynamicRelevance)
+    {
+        if (!View.DynamicMeshElementRanges.IsValidIndex(Index)) return true;
+        const FInt32Vector2 StoredRange = View.DynamicMeshElementRanges[Index];
+        if (StoredRange.X < 0 || StoredRange.X > StoredRange.Y ||
+            StoredRange.Y > View.DynamicMeshElements.Num()) return true;
+        const FInt32Range Range = View.GetDynamicMeshElementRange(Index);
+        if (!Range.IsEmpty())
+        {
+            for (int32 MeshIndex = Range.GetLowerBoundValue(); MeshIndex < Range.GetUpperBoundValue(); ++MeshIndex)
+            {
+                const FMeshBatchAndRelevance& Batch = View.DynamicMeshElements[MeshIndex];
+                if (Batch.PrimitiveSceneProxy != Proxy || !Batch.Mesh) return true;
+                if (IsFloorCausticsOccluderBatch(*Batch.Mesh, View.GetFeatureLevel())) return true;
+            }
+        }
+    }
+    return false;
+}
