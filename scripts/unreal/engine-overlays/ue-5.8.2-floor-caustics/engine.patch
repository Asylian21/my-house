+void PrepareFloorCaustics(FRDGBuilder& GraphBuilder, const FViewInfo& View, const FSceneTextures& SceneTextures)
+{
+    check(IsInRenderingThread());
+    TSharedPtr<IFloorCausticsProvider, ESPMode::ThreadSafe> Provider = GFloorCausticsProvider;
+    if (CVarFloorCaustics.GetValueOnRenderThread() != 1 || !Provider) return;
+    bool bPrepared = false;
+    const TCHAR* Rejection = TEXT("unsupported-view-or-render-format");
+    ON_SCOPE_EXIT { if (!bPrepared) Provider->Rejected_RenderThread(View, Rejection); };
+    const auto RejectIf = [&Rejection](bool Condition, const TCHAR* Reason)
+    {
+        if (Condition) Rejection = Reason;
+        return Condition;
+    };
+    // Match UE's actual legacy MATERIAL_ROUGHDIFFUSE selection. The Mac
+    // r.Substrate.RoughDiffuse default is irrelevant while Substrate is disabled.
+    if (RejectIf(!View.Family || !View.Family->Scene, TEXT("missing-view-family-or-scene")) ||
+        RejectIf(View.Family->Views.Num() != 1, TEXT("multiple-views-unsupported")) ||
+        RejectIf(View.bIsSceneCapture || View.bIsReflectionCapture || View.bIsPlanarReflection ||
+            View.bIsInstancedStereoEnabled, TEXT("capture-or-stereo-view-unsupported")) ||
+        RejectIf(View.IsUnderwater(), TEXT("underwater-view-unsupported")) ||
+        RejectIf(!View.ShouldRenderView(), TEXT("view-not-rendered")) ||
+        RejectIf(Substrate::IsSubstrateEnabled(), TEXT("substrate-view-unsupported")) ||
+        RejectIf(!IntCvarEquals(TEXT("r.Material.RoughDiffuse"), 0), TEXT("legacy-rough-diffuse-unsupported")) ||
+        RejectIf(IsForwardShadingEnabled(View.GetShaderPlatform()), TEXT("forward-shading-unsupported")) ||
+        RejectIf(!IntCvarEquals(TEXT("r.CustomDepth"), 3), TEXT("custom-depth-mode-not-three")) ||
+        RejectIf(!IntCvarEquals(TEXT("r.CustomDepthTemporalAAJitter"), 1), TEXT("custom-depth-jitter-disabled")) ||
+        RejectIf(!IntCvarEquals(TEXT("r.Water.SingleLayer.RefractionDownsampleFactor"), 1), TEXT("refraction-downsample-not-one")) ||
+        RejectIf(!IntCvarEquals(TEXT("r.Water.SingleLayer.UnderwaterFogWhenCameraIsAboveWater"), 0), TEXT("above-water-underwater-fog-enabled")) ||
+        RejectIf(!HasBeenProduced(SceneTextures.CustomDepth.Depth), TEXT("custom-depth-not-produced")) ||
+        RejectIf(!SceneTextures.CustomDepth.Stencil, TEXT("custom-stencil-missing")) ||
+        RejectIf(!SceneTextures.Color.Target, TEXT("scene-color-target-missing")) ||
+        RejectIf(SceneTextures.Color.Target != SceneTextures.Color.Resolve, TEXT("scene-color-resolve-differs")) ||
+        RejectIf(!RHIPixelFormatHasCapabilities(PF_FloatRGBA, EPixelFormatCapabilities::RenderTarget |
+            EPixelFormatCapabilities::TextureBlendable | EPixelFormatCapabilities::TextureSample), TEXT("float-rgba-capabilities-missing")) ||
+        RejectIf(SceneTextures.Color.Target->Desc.NumSamples != 1, TEXT("scene-color-multisampled")) ||
+        RejectIf(SceneTextures.Color.Target->Desc.Format != PF_FloatRGBA, TEXT("scene-color-not-float-rgba"))) return;
+
+    FFloorCausticsGraphRecord& Record = GraphBuilder.Blackboard.GetOrCreate<FFloorCausticsGraphState>().Record;
+    if (Record.View) return; // exactly one prepare per graph; never replace a live frame
+    Rejection = TEXT("invalid-source-selection-or-water-side");
+    FFloorCausticsSelection Selection;
+    if (!Provider->Select_RenderThread(View, Selection) ||
+        Selection.SceneToken != View.Family->Scene || !Selection.Generation ||
+        !Selection.Floor.IsValid() || !Selection.Sun.IsValid() || !Selection.UniqueStencil ||
+        !Selection.SourceBoundsCm.IsValid || !IsSha256(Selection.SourceContractSha256) ||
+        Selection.SourceBoundsCm.Min.ContainsNaN() || Selection.SourceBoundsCm.Max.ContainsNaN() ||
+        Selection.SourceBoundsCm.GetSize().GetMin() <= 0 ||
+        !FMath::IsFinite(Selection.WaterSurfaceZCm) ||
+        Selection.WaterSurfaceZCm <= Selection.SourceBoundsCm.Max.Z ||
+        View.ViewLocation.Z <= Selection.WaterSurfaceZCm + 0.05) return;
+
+    Rejection = TEXT("primitive-identity-stencil-or-bounds-rejected");
+    FScene* Scene = View.Family->Scene->GetRenderScene();
+    if (!Scene || Scene->HasVolumetricCloud()) return; // SLW cloud-copy modulation needs paired transport first
+    const FPrimitiveSceneProxy* Floor = nullptr;
+    constexpr double EdgeGuardCm = 0.05;
+    TArray<FPrimitiveComponentId, TInlineAllocator<32>> ExcludedIds;
+    TArray<FVector4f, TInlineAllocator<32>> Exclusions;
+    int32 FloorIdCount = 0, StencilOwners = 0;
+    for (const FPrimitiveSceneInfo* Info : Scene->Primitives)
+    {
+        if (!Info || !Info->Proxy) continue;
+        const FPrimitiveSceneProxy* Proxy = Info->Proxy;
+        if (Proxy->GetPrimitiveComponentId() == Selection.Floor) { ++FloorIdCount; Floor = Proxy; }
+        // Equal custom/scene depth cannot disambiguate a coincident foreign
+        // primitive. Exclude its conservative XY bounds locally; do not turn
+        // known submerged steps into a reason to disable the entire floor.
+        if (!(Proxy->GetPrimitiveComponentId() == Selection.Floor) &&
+            Proxy->ShouldRenderInMainPass() && Proxy->IsShown(&View))
+        {
+            const FBox Other = Proxy->GetBounds().GetBox();
+            const FBox& B = Selection.SourceBoundsCm;
+            if (Other.Min.Z <= B.Max.Z + EdgeGuardCm && Other.Max.Z >= B.Max.Z - EdgeGuardCm &&
+                Other.Min.X < B.Max.X - EdgeGuardCm && Other.Max.X > B.Min.X + EdgeGuardCm &&
+                Other.Min.Y < B.Max.Y - EdgeGuardCm && Other.Max.Y > B.Min.Y + EdgeGuardCm &&
+                IsFloorCausticsOccluder(View, *Info))
+            {
+                if (Exclusions.Num() == 32) return; // bounded shader interface
+                ExcludedIds.Add(Proxy->GetPrimitiveComponentId());
+                Exclusions.Add(FVector4f(Other.Min.X - EdgeGuardCm, Other.Min.Y - EdgeGuardCm,
+                    Other.Max.X + EdgeGuardCm, Other.Max.Y + EdgeGuardCm));
+            }
+        }
+        if (!Proxy->ShouldRenderCustomDepth()) continue;
+        // Partial masks on any custom-depth primitive could synthesize our
+        // stencil value; reject instead of guessing per-pixel identity.
+        if (Proxy->GetStencilWriteMask() != EStencilMask::SM_Default &&
+            Proxy->GetStencilWriteMask() != EStencilMask::SM_255) return;
+        if (Proxy->GetCustomDepthStencilValue() == Selection.UniqueStencil)
+        {
+            ++StencilOwners;
+            if (!(Proxy->GetPrimitiveComponentId() == Selection.Floor)) return;
+        }
+    }
+    if (FloorIdCount != 1 || !Floor || !Floor->ShouldRenderCustomDepth() || StencilOwners != 1 ||
+        !Floor->GetBounds().GetBox().Min.Equals(Selection.SourceBoundsCm.Min, 0.05) ||
+        !Floor->GetBounds().GetBox().Max.Equals(Selection.SourceBoundsCm.Max, 0.05)) return;
+
+    Rejection = TEXT("sun-identity-or-unsupported-light-modulation");
+    const FLightSceneInfo* Sun = nullptr;
+    int32 SunCount = 0;
+    for (const FLightSceneInfoCompact& Compact : Scene->Lights)
+    {
+        if (Compact.LightSceneInfo && Compact.LightSceneInfo->Proxy &&
+            Compact.LightSceneInfo->Proxy->GetLightComponentId() == Selection.Sun)
+        { ++SunCount; Sun = Compact.LightSceneInfo; }
+    }
+    if (SunCount != 1 || !Sun || !Sun->ShouldRenderLight(View) ||
+        Sun->Proxy->GetLightType() != LightType_Directional || Sun->Proxy->GetLightFunctionMaterial() ||
+        Sun->Proxy->GetPerPixelTransmittanceEnabled() || Sun->Proxy->GetCastCloudShadows() ||
+        !(Sun->Proxy->GetLightingChannelMask() & Floor->GetLightingChannelMask())) return;
+    const FLinearColor Color = Sun->Proxy->GetSunIlluminanceOnGroundPostTransmittance();
+    FFloorCausticsBuildInputs Inputs;
+    Inputs.Selection = Selection;
+    Inputs.ConservativeExcludedPrimitives.Append(ExcludedIds);
+    Inputs.ConservativeExcludedBoundsXYCm.Append(Exclusions);
+    Inputs.FrameCounter = View.Family->FrameCounter;
+    Inputs.FrameNumber = View.Family->FrameNumber;
+    Inputs.WorldTimeSeconds = float(View.Family->Time.GetWorldTimeSeconds());
+    Inputs.ViewPreExposure = View.PreExposure;
+    Inputs.SunTravelDirection = FVector3f(Sun->Proxy->GetDirection());
+    Inputs.SunIlluminance = FVector3f(Color.R, Color.G, Color.B);
+    if (!FinitePositive(Inputs.SunIlluminance) || !FMath::IsFinite(Inputs.WorldTimeSeconds) ||
+        Inputs.SunTravelDirection.ContainsNaN() || Inputs.SunTravelDirection.Z >= -1e-5f) return;
+    Rejection = TEXT("unvalidated-or-unpaired-producer-frame");
+    FFloorCausticsProducedFrame Produced;
+    if (!Provider->Build_RenderThread(GraphBuilder, View, Inputs, Produced) ||
+        !Produced.bSourceTransportValidated || Produced.SceneToken != Selection.SceneToken ||
+        Produced.Generation != Selection.Generation || Produced.FrameCounter != Inputs.FrameCounter ||
+        Produced.FrameNumber != Inputs.FrameNumber || Produced.WorldTimeSeconds != Inputs.WorldTimeSeconds ||
+        !Produced.NormalizedIrradiance || !HasBeenProduced(Produced.NormalizedIrradiance) ||
+        Produced.NormalizedIrradiance->Desc.NumSamples != 1 ||
+        !EnumHasAllFlags(Produced.NormalizedIrradiance->Desc.Flags, TexCreate_ShaderResource) ||
+        Produced.NormalizedIrradiance->Desc.Format != PF_FloatRGBA ||
+        Produced.NormalizedIrradiance->Desc.Dimension != ETextureDimension::Texture2D ||
+        Produced.NormalizedIrradiance->Desc.Extent.GetMin() < 2) return;
+
+    FRDGTextureRef Companion = GraphBuilder.CreateTexture(FRDGTextureDesc::Create2D(
+        SceneTextures.Config.Extent, PF_FloatRGBA, FClearValueBinding::Black,
+        TexCreate_ShaderResource | TexCreate_RenderTargetable), TEXT("FloorCaustics.Companion"));
+    FRDGBufferRef Counters = GraphBuilder.CreateBuffer(FRDGBufferDesc::CreateBufferDesc(sizeof(uint32), 4),
+        TEXT("FloorCaustics.ValidationCounters"));
+    FRDGBufferUAVRef CounterUAV = GraphBuilder.CreateUAV(Counters, PF_R32_UINT);
+    AddClearUAVPass(GraphBuilder, CounterUAV, 0u);
+    auto* P = GraphBuilder.AllocParameters<FFloorCausticsPreparePS::FParameters>();
+    P->View = View.ViewUniformBuffer;
+    P->SceneTextures = CreateSceneTextureUniformBuffer(GraphBuilder, &SceneTextures, View.GetFeatureLevel(), ESceneTextureSetupMode::All);
+    P->NormalizedIrradiance = Produced.NormalizedIrradiance;
+    P->IrradianceSampler = TStaticSamplerState<SF_Bilinear, AM_Clamp, AM_Clamp, AM_Clamp>::GetRHI();
+    P->SourceMinTranslated = FVector3f(Selection.SourceBoundsCm.Min + View.ViewMatrices.GetPreViewTranslation());
+    P->SourceMaxTranslated = FVector3f(Selection.SourceBoundsCm.Max + View.ViewMatrices.GetPreViewTranslation());
+    P->SourceSunIlluminance = Inputs.SunIlluminance;
+    P->SourceDiffuseScale = FMath::Clamp(Sun->Proxy->GetDiffuseScale(), 0.0f, 1.0f);
+    P->SourceStencil = Selection.UniqueStencil;
+    P->OccluderExclusionCount = Exclusions.Num();
+    const FVector Translation = View.ViewMatrices.GetPreViewTranslation();
+    for (uint32 Index = 0; Index < 32; ++Index)
+    {
+        const FVector4f E = Index < uint32(Exclusions.Num()) ? Exclusions[Index] : FVector4f(0, 0, 0, 0);
+        P->OccluderExclusions[Index] = E + FVector4f(Translation.X, Translation.Y, Translation.X, Translation.Y);
+    }
+    P->ValidationCounters = CounterUAV;
+    P->RenderTargets[0] = FRenderTargetBinding(Companion, ERenderTargetLoadAction::EClear);
+    TShaderMapRef<FFloorCausticsPreparePS> Shader(View.ShaderMap);
+    FPixelShaderUtils::AddFullscreenPass(GraphBuilder, View.ShaderMap,
+        RDG_EVENT_NAME("FloorCaustics Prepare"), Shader, P, View.ViewRect);
+    Record.View = &View;
+    Record.Sun = Sun;
+    Record.Companion = Companion;
+    Record.Inputs = Inputs;
+    bPrepared = true;
+    Provider->Observe_RenderThread(GraphBuilder, View, Inputs, Companion, Counters);
+}
+
+FRDGTextureRef GetFloorCausticsCompanion(FRDGBuilder& GraphBuilder, const FSceneView& View, bool bRequireComposited)
+{
+    const auto& R = GraphBuilder.Blackboard.GetOrCreate<FFloorCausticsGraphState>().Record;
+    return R.View == &View && (!bRequireComposited || R.bComposited) ? R.Companion : nullptr;
+}
+bool IsFloorCausticsSelectedSun(FRDGBuilder& GraphBuilder, const FSceneView& View, const FLightSceneInfo& Light)
+{
+    const auto& R = GraphBuilder.Blackboard.GetOrCreate<FFloorCausticsGraphState>().Record;
+    return R.View == &View && R.Companion && R.Sun == &Light;
+}
+void ObserveFloorCausticsDownstream(FRDGBuilder& GraphBuilder,
+    const FViewInfo& View, const FSceneTextures& SceneTextures,
+    EFloorCausticsObservationStage Stage)
+{
+    check(IsInRenderingThread());
+    TSharedPtr<IFloorCausticsProvider, ESPMode::ThreadSafe> Provider = GFloorCausticsProvider;
+    if (!Provider) return;
+    const auto& R = GraphBuilder.Blackboard.GetOrCreate<FFloorCausticsGraphState>().Record;
+    const bool bPreparedForView = R.View == &View && R.Companion;
+    FFloorCausticsObservation Observation;
+    Observation.Stage = Stage;
+    Observation.SceneColor = SceneTextures.Color.Target;
+    Observation.SceneDepth = SceneTextures.Depth.Target;
+    Observation.Companion = bPreparedForView ? R.Companion : nullptr;
+    Observation.PreparedInputs = bPreparedForView ? &R.Inputs : nullptr;
+    Observation.bComposited = bPreparedForView && R.bComposited;
+    Observation.ViewPreExposure = View.PreExposure;
+    Provider->ObserveDownstream_RenderThread(GraphBuilder, View, Observation);
+}
+
+void CompositeFloorCaustics(FRDGBuilder& GraphBuilder, const FViewInfo& View, const FSceneTextures& SceneTextures)
+{
+    ObserveFloorCausticsDownstream(GraphBuilder, View, SceneTextures,
+        EFloorCausticsObservationStage::BeforeComposite);
+    auto& R = GraphBuilder.Blackboard.GetOrCreate<FFloorCausticsGraphState>().Record;
+    if (R.View == &View && R.Companion && !R.bComposited)
+    {
+        auto* P = GraphBuilder.AllocParameters<FFloorCausticsCompositePS::FParameters>();
+        P->Replacement = R.Companion;
+        P->RenderTargets[0] = FRenderTargetBinding(SceneTextures.Color.Target, ERenderTargetLoadAction::ELoad);
+        TShaderMapRef<FFloorCausticsCompositePS> Shader(View.ShaderMap);
+        FPixelShaderUtils::AddFullscreenPass(GraphBuilder, View.ShaderMap,
+            RDG_EVENT_NAME("FloorCaustics Composite"), Shader, P, View.ViewRect,
+            TStaticBlendState<CW_RGB, BO_Add, BF_One, BF_One>::GetRHI());
+        R.bComposited = true;
+    }
+    ObserveFloorCausticsDownstream(GraphBuilder, View, SceneTextures,
+        EFloorCausticsObservationStage::AfterComposite);
+}
