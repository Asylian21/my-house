#include "/Engine/Private/Common.ush"
#include "/Engine/Private/RayTracing/RayTracingCommon.ush"
#include "/Engine/Private/RayTracing/TraceRayInline.ush"
struct SentinelData { float4 OriginMin; float4 DirectionMax; float4 Expected; };
struct IncomingResult { float4 HitPositionAndDistanceCm; uint4 NativeIdentity; uint4 State; };
RaytracingAccelerationStructure IncomingTLAS;
StructuredBuffer<SentinelData> IncomingSentinels;
RWStructuredBuffer<IncomingResult> RWIncomingVisibility;
RWStructuredBuffer<uint> RWIncomingGates;
float3 IncomingSunTravel;
float3 IncomingPreViewTranslationCm;
float4 IncomingAperture;
float IncomingWaterZMetres;
[numthreads(32,1,1)]
void IncomingCS(uint3 dispatch : SV_DispatchThreadID)
{
    uint i=dispatch.x; const uint N=512*230; if(i>=N+6) return;
    uint2 pixel=uint2(i%512,i/512);
    float2 xy=IncomingAperture.xy+(float2(pixel)+.5)/float2(512,230)*IncomingAperture.zw;
    float3 origin=float3(xy*100,IncomingWaterZMetres*100+.2); // documented 2mm air-side offset
    float3 direction=-normalize(IncomingSunTravel); float tMin=.01,tMax=50000;
    SentinelData sentinel=(SentinelData)0;
    if(i>=N) { sentinel=IncomingSentinels[i-N]; origin=sentinel.OriginMin.xyz; direction=sentinel.DirectionMax.xyz; tMin=sentinel.OriginMin.w;tMax=sentinel.DirectionMax.w; }
    FRayDesc ray;ray.Origin=origin+IncomingPreViewTranslationCm;ray.Direction=direction;ray.TMin=tMin;ray.TMax=tMax;
    FTraceRayInlineContext context=CreateTraceRayInlineContext();context.MaxIterations=128;
    // Existing tested helper forces opaque and skips procedural primitives.
    FTraceRayInlineResult hit=TraceRayInline(IncomingTLAS,RAY_FLAG_NONE,RAY_TRACING_MASK_OPAQUE_SHADOW,ray.GetNativeDesc(),context);
    IncomingResult result=(IncomingResult)0;result.NativeIdentity=uint4(0xffffffff,0xffffffff,0xffffffff,0xffffffff);
    result.HitPositionAndDistanceCm=float4(origin,-1);result.State=uint4(0,i,RAY_TRACING_MASK_OPAQUE_SHADOW,hit.bIsCompleted?1:0);
    uint flags=0;
    if(!hit.bIsCompleted) { result.State.x=2;flags|=1; }
    else if(hit.IsHit()) { result.State.x=1;result.HitPositionAndDistanceCm=float4(origin+direction*hit.HitT,hit.HitT);result.NativeIdentity=uint4(hit.InstanceID,hit.InstanceIndex,hit.PrimitiveIndex,hit.GeometryIndex); }
    if(i>=N && (result.State.x!=(uint)sentinel.Expected.x || (sentinel.Expected.x==1 && abs(hit.HitT-sentinel.Expected.y)>sentinel.Expected.z))) flags|=2;
    if(flags!=0) InterlockedOr(RWIncomingGates[0],flags);
    RWIncomingVisibility[i]=result;
}
